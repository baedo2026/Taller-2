# Configuración de desarrollo para docker compose
POSTGRES_DB=taller_backend
POSTGRES_USER=taller_user
POSTGRES_PASSWORD=taller_password
POSTGRES_PORT=5432
ADMINER_PORT=8080
API_PORT=3000

# Para ejecutar FastAPI fuera de Docker, usa localhost:
DATABASE_URL=postgresql+psycopg://taller_user:taller_password@localhost:5432/taller_backend